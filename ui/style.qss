QLabel#label_plan {
    font-size: 22px;
    font-weight: bold;
}

QTableWidget#table{
    min-width: 100px;
    max-width: 1000px;
}

QPushButton#main {
    background-color: #cccac2;
    color: #3B3635;
    font-size: 16px;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 8px;
    border: 2px solid #807e78;
    min-width: 10px;
    max-width: 200px;

}
QPushButton:hover#main {
    background-color: rgba(255, 255, 255, 0.7);
    border: 2px solid #b0b0b0;
}
QPushButton#export {
    background-color: #cccac2;
    color: #3B3635;
    font-size: 15px;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 8px;
    border: 2px solid #807e78;
    min-width: 10px;
    max-width: 50px;

}
QPushButton:hover#export {
    background-color: rgba(255, 255, 255, 0.7);
    border: 2px solid #b0b0b0;
}

QComboBox#dropdown_devices {
    background-color: #cccac2;
    color: #3B3635;
    font-size: 16px;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 8px;
    border: 2px solid #807e78;
    min-width: 100px;
    max-width: 200px;
}

QHeaderView::section {
    background-color: #cecfc8;
    color: #000000;
    font-weight: bold;
    padding: 6px;
    border: 1px solid #B7B7B7;
}

/* show_summary.py */

QLabel#label_summary{
    font-size: 22px;
}
QLabel#label_summary_text{
    margin-bottom: 10px;
    font-size: 12px;
    color: #857F7E;
}
QLabel#selection_text{
    font-size: 14px;
    color: #000000;
    margin-top: 10px;
}
QRadioButton{
    color: #857F7E;
    spacing: 6px;
    margin-right: 25px;
}