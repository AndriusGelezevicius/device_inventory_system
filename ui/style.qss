QLabel#label_plan {
    font-size: 22px;
    font-weight: bold;
}

QTableWidget#table{
    min-width: 100px;
    max-width: 1000px;
}

QPushButton#main {
    background-color: #cccac2;
    color: #3B3635;
    font-size: 16px;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 8px;
    border: 2px solid #807e78;
    min-width: 10px;
    max-width: 200px;

}
QPushButton:hover#main {
    background-color: rgba(255, 255, 255, 0.7);
    border: 2px solid #b0b0b0;
}
QPushButton#export {
    background-color: #cccac2;
    color: #3B3635;
    font-size: 15px;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 8px;
    border: 2px solid #807e78;
    min-width: 10px;
    max-width: 50px;

}
QPushButton:hover#export {
    background-color: rgba(255, 255, 255, 0.7);
    border: 2px solid #b0b0b0;
}

QComboBox#dropdown_devices {
    background-color: #cccac2;
    color: #3B3635;
    font-size: 16px;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 8px;
    border: 2px solid #807e78;
    min-width: 100px;
    max-width: 200px;
}

QHeaderView::section {
    background-color: #cecfc8;
    color: #000000;
    font-weight: bold;
    padding: 6px;
    border: 1px solid #B7B7B7;
}

/* show_summary.py */

QLabel#label_summary{
    font-size: 22px;
}
QLabel#label_summary_text{
    margin-bottom: 10px;
    font-size: 12px;
    color: #857F7E;
}
QLabel#selection_text{
    font-size: 14px;
    color: #000000;
    margin-top: 10px;
}
QRadioButton{
    spacing: 6px;
    margin-right: 25px;
}

QPushButton#button_clear,
QPushButton#button_calculate {
    font-size: 14px;
    font-weight: bold;
    margin-top: 10px;
    padding: 2px 10px;
    border-radius: 6px;
}

/* Clear */
QPushButton#button_clear {
    background-color: #F3F4F6;
    color: #374151;
    border: 1px solid #D1D5DB;
}

QPushButton#button_clear:hover {
    background-color: #E5E7EB;
}

QPushButton#button_clear:pressed {
    background-color: #D1D5DB;
}

/* Calculate */
QPushButton#button_calculate {
    background-color: #2563EB;
    color: white;
    border: 1px solid #2563EB;
}

QPushButton#button_calculate:hover {
    background-color: #1D4ED8;
}

QPushButton#button_calculate:pressed {
    background-color: #1E40AF;
}

QFrame#results_line{
    height: 1px;
    background-color: #D1D5DB;
    border: none;
}
QLabel#result_label{
    font-weight: bold;
    font-size: 14px;
}
QLabel#results_period {
    font-size: 12px;
    color: #6B7280;
}

QLabel#results_total {
    font-size: 18px;
    color: #111827;
    margin-bottom: 8px;
}
QTableWidget#results_table {
    background-color: transparent;
    color: #374151;
    border: none;
    gridline-color: #E5E7EB;
    font-size: 13px;
}